# ─── CONFIGURAÇÃO DO BOT ───────────────────────────────────────────────────────

# Token do seu bot (obtido no @BotFather)
BOT_TOKEN=7123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID do canal onde os sinais serão enviados
# Use @nomecanal para canais públicos ou -100xxxxxxxxxx para privados
CHANNEL_ID=@seu_canal_aviator

# IDs dos administradores (separe por vírgula sem espaços)
# Para descobrir seu ID, fale com @userinfobot no Telegram
ADMIN_IDS=123456789,987654321
